<section class="auth">
    <div class="auth-visual grain">
        <div class="hero-bg-word" aria-hidden="true">EROS</div>
        <span class="eyebrow position-relative" style="z-index:2;">Bienvenido de vuelta</span>
        <img src="/img/garments/Wine Attribute.png" alt="">
        <blockquote>“La moda es la armadura para <span>sobrevivir</span> la realidad de todos los días.”</blockquote>
    </div>

    <div class="auth-form-side">
        <div class="auth-card">
            <span class="eyebrow">Iniciar sesión</span>
            <h1>Entra al estudio</h1>
            <p class="sub">Tus prendas y outfits te están esperando.</p>

            <form action="/login" method="POST" novalidate id="loginForm">
                <div class="field">
                    <label for="email">Correo electrónico</label>
                    <input type="email" id="email" name="email" class="form-control" autocomplete="email" required autofocus>
                </div>
                <div class="field">
                    <label for="password">Contraseña</label>
                    <div class="password-wrap">
                        <input type="password" id="password" name="password" class="form-control" autocomplete="current-password" required>
                        <button type="button" class="password-toggle" aria-label="Mostrar contraseña">{{{icon 'eye'}}}</button>
                    </div>
                </div>
                <button type="submit" class="btn-eros w-100 mt-2">Entrar {{{icon 'arrow'}}}</button>
            </form>

            <p class="auth-switch">¿Aún no tienes cuenta? <a href="/register">Créala gratis</a></p>
        </div>
    </div>
</section>

<script src="/js/validation.js?v=2"></script>
