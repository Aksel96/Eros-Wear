<section class="page-hero grain">
    <div class="hero-bg-word" aria-hidden="true" data-parallax="-0.1">SHOP</div>
    <div class="wrap">
        <span class="eyebrow" data-hero style="--h:0">Catálogo oficial</span>
        <h1 data-hero style="--h:1">La <span class="outline">colección</span></h1>
        <p data-hero style="--h:2">Piezas que mezclan la sastrería clásica con la actitud de la calle. Elige talla, arma tu carrito y envíanos tu pedido por WhatsApp.</p>
    </div>
</section>

<section class="section tight-top" style="padding-top:0;padding-bottom:3rem">
    <div class="wrap">
        <form method="GET" action="/shop" class="toolbar" id="shopFilters">
            <div class="chips" role="group" aria-label="Filtrar por categoría">
                {{#each filters}}
                    <a class="chip {{#if (eq value ../currentCategory)}}active{{/if}}"
                       href="/shop?category={{value}}{{#unless (eq ../currentSort 'default')}}&sort_by={{../currentSort}}{{/unless}}{{#if ../q}}&q={{../q}}{{/if}}">
                        {{label}} <span class="count">{{count}}</span>
                    </a>
                {{/each}}
            </div>
            <div class="toolbar-right">
                <input type="hidden" name="category" value="{{currentCategory}}">
                <label class="search-field">
                    {{{icon 'search'}}}
                    <input type="search" name="q" value="{{q}}" placeholder="Buscar prenda" aria-label="Buscar prenda">
                </label>
                <select name="sort_by" class="select select-sm" aria-label="Ordenar" onchange="this.form.submit()" style="width:auto">
                    <option value="default" {{#if (eq currentSort 'default')}}selected{{/if}}>Nombre (A-Z)</option>
                    <option value="price_asc" {{#if (eq currentSort 'price_asc')}}selected{{/if}}>Precio: menor a mayor</option>
                    <option value="price_desc" {{#if (eq currentSort 'price_desc')}}selected{{/if}}>Precio: mayor a menor</option>
                    <option value="likes" {{#if (eq currentSort 'likes')}}selected{{/if}}>Más favoritas</option>
                    <option value="usage" {{#if (eq currentSort 'usage')}}selected{{/if}}>Más usadas en outfits</option>
                </select>
            </div>
        </form>

        {{#if dbError}}
            <div class="db-alert mt-3">No pudimos cargar el catálogo. Revisa la conexión con la base de datos.</div>
        {{/if}}

        <p class="result-count">
            <strong>{{resultCount}}</strong> {{#if (eq resultCount 1)}}prenda{{else}}prendas{{/if}}
            {{#if q}}para “{{q}}”{{/if}}
            {{#unless user}} · <a href="/login">Inicia sesión</a> para usar el probador{{/unless}}
        </p>

        {{#if garments}}
            <div class="grid grid-products" data-stagger>
                {{#each garments}}
                    <div class="product-wrap" data-reveal="up" style="--i:{{@index}}">
                        {{> productCard this}}
                        {{#if ../user}}
                            <button type="button" class="fav-icon-btn {{#if is_favorite}}is-active{{/if}}" data-garment-id="{{id}}" data-is-favorite="{{is_favorite}}"
                                    title="{{#if is_favorite}}Quitar de mi probador{{else}}Agregar a mi probador{{/if}}"
                                    aria-label="{{#if is_favorite}}Quitar de mi probador{{else}}Agregar a mi probador{{/if}}" aria-pressed="{{#if is_favorite}}true{{else}}false{{/if}}">
                                {{{icon 'hanger'}}}
                            </button>
                        {{/if}}
                    </div>
                {{/each}}
            </div>
        {{else}}
            <div class="empty-state">
                <div class="empty-icon">{{{icon 'search'}}}</div>
                <h3>Sin resultados</h3>
                <p>No encontramos prendas con esos filtros. Prueba con otra categoría o búsqueda.</p>
                <a href="/shop" class="btn btn-ghost">Limpiar filtros</a>
            </div>
        {{/if}}
    </div>
</section>

<script src="/js/shop.js?v=4"></script>
