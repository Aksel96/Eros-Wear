<section class="auth">
    <div class="auth-visual grain">
        <div class="hero-bg-word" aria-hidden="true">EROS</div>
        <span class="eyebrow position-relative" style="z-index:2;">Únete a la comunidad</span>
        <img src="/img/garments/chaqueta-morada.png" alt="">
        <blockquote>Crea, combina y comparte looks con <span>actitud</span>.</blockquote>
    </div>

    <div class="auth-form-side">
        <div class="auth-card">
            <span class="eyebrow">Crear cuenta</span>
            <h1>Tu firma de estilo</h1>
            <p class="sub">Gratis, en menos de un minuto.</p>

            <form action="/register" method="POST" id="registrationForm" novalidate>
                <div class="field">
                    <label for="nickname">Apodo</label>
                    <input type="text" id="nickname" name="nickname" class="form-control" maxlength="50" autocomplete="nickname" required autofocus>
                    <div id="nicknameFeedback" class="invalid-feedback"></div>
                </div>
                <div class="field">
                    <label for="email">Correo electrónico</label>
                    <input type="email" id="email" name="email" class="form-control" autocomplete="email" required>
                    <div id="emailFeedback" class="invalid-feedback"></div>
                </div>
                <div class="field">
                    <label for="password">Contraseña</label>
                    <div class="password-wrap">
                        <input type="password" id="password" name="password" class="form-control" autocomplete="new-password" required>
                        <button type="button" class="password-toggle" aria-label="Mostrar contraseña">{{{icon 'eye'}}}</button>
                    </div>
                    <div class="strength" aria-hidden="true"><span id="strengthBar"></span></div>
                    <div id="passwordFeedback" class="invalid-feedback d-block"></div>
                </div>
                <div class="field">
                    <label for="confirm_password">Confirmar contraseña</label>
                    <input type="password" id="confirm_password" class="form-control" autocomplete="new-password" required>
                    <div id="confirmPasswordFeedback" class="invalid-feedback"></div>
                </div>
                <button type="submit" class="btn-eros w-100 mt-2">Crear mi cuenta {{{icon 'arrow'}}}</button>
            </form>

            <p class="auth-switch">¿Ya tienes cuenta? <a href="/login">Inicia sesión</a></p>
        </div>
    </div>
</section>

<script src="/js/validation.js?v=2"></script>
