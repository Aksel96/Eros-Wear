<section class="studio">
    <div class="wrap">
        {{#if user}}
            <div class="studio-head">
                <div>
                    <span class="eyebrow">Probador</span>
                    <h1>Tu <span class="outline">estudio</span></h1>
                </div>
                <div class="cluster">
                    <a href="/shop" class="btn btn-light btn-sm">{{{icon 'plus'}}} Agregar prendas</a>
                    <a href="/gallery?mine=1" class="btn btn-light btn-sm">{{{icon 'grid'}}} Mis outfits</a>
                </div>
            </div>

            {{#if dbError}}
                <div class="db-alert mb-2">No pudimos cargar tus prendas. Revisa la conexión con la base de datos.</div>
            {{/if}}

            <div class="studio-grid" id="studio" data-user-id="{{user.id}}">
                {{!-- Lienzo --}}
                <div class="canvas-wrap">
                    <div class="canvas-toolbar">
                        <div class="canvas-name">
                            <input type="text" id="outfitName" maxlength="100" placeholder="Nombra tu outfit" aria-label="Nombre del outfit">
                            <span class="mode-badge is-hidden" id="modeBadge">Editando</span>
                        </div>
                    </div>

                    <div id="outfit-canvas" aria-label="Lienzo del outfit">
                        <div class="canvas-empty">
                            {{{icon 'layers'}}}
                            <strong>Tu lienzo está listo</strong>
                            <span>Arrastra una prenda aquí o tócala para agregarla</span>
                        </div>
                    </div>

                    <div class="canvas-actions">
                        <div class="left">
                            <button type="button" class="icon-btn" id="bringFront" title="Traer al frente" aria-label="Traer al frente" disabled>{{{icon 'front'}}}</button>
                            <button type="button" class="icon-btn" id="removeItem" title="Quitar prenda seleccionada" aria-label="Quitar prenda seleccionada" disabled>{{{icon 'trash'}}}</button>
                            <button type="button" class="icon-btn" id="clearCanvas" title="Limpiar lienzo" aria-label="Limpiar lienzo">{{{icon 'undo'}}}</button>
                        </div>
                        <button type="button" class="btn" id="saveOutfit">{{{icon 'save'}}} <span id="saveLabel">Guardar outfit</span></button>
                    </div>

                    <div class="look-total">
                        <div><span>Total del look</span><strong id="lookTotal">$0</strong></div>
                        <button type="button" class="btn btn-rose btn-sm" id="addLookToCart" disabled>{{{icon 'bag'}}} Agregar look al carrito</button>
                    </div>
                </div>

                {{!-- Prendas del usuario --}}
                <aside class="studio-panel catalog">
                    <h2>Tus prendas <span class="count">{{garments.length}}</span></h2>
                    {{#if garments}}
                        <div class="studio-catalog" id="garment-catalog">
                            {{#each garments}}
                                <div class="garment-tile" draggable="true" tabindex="0" role="button"
                                     data-id="{{id}}" data-name="{{name}}" data-src="{{image_url}}" data-price="{{price}}"
                                     aria-label="Agregar {{name}} al lienzo">
                                    <img src="{{image_url}}" alt="" loading="lazy">
                                    <span>{{name}}</span>
                                    <i class="add-hint" aria-hidden="true">+</i>
                                </div>
                            {{/each}}
                        </div>
                    {{else}}
                        <div class="center" style="padding:1.5rem .5rem">
                            <p class="text-soft mb-2" style="font-size:.9rem">Todavía no tienes prendas. Agrégalas desde el catálogo para combinarlas aquí.</p>
                            <a href="/shop" class="btn btn-rose btn-sm">Ir al catálogo</a>
                        </div>
                    {{/if}}
                </aside>

                {{!-- Ayuda --}}
                <aside class="studio-aside-right">
                    <div class="studio-panel">
                        <h2>Cómo usarlo</h2>
                        <ol class="tips">
                            <li><span>Agrega prendas desde el catálogo.</span></li>
                            <li><span>Arrástralas al lienzo o tócalas para colocarlas.</span></li>
                            <li><span>Muévelas libremente; con <kbd>←</kbd><kbd>→</kbd> afinas la posición.</span></li>
                            <li><span>Selecciona una prenda y pulsa <kbd>Supr</kbd> para quitarla.</span></li>
                            <li><span>Ponle nombre y guárdalo en la galería.</span></li>
                        </ol>
                    </div>
                </aside>
            </div>
        {{else}}
            <div class="gate" data-reveal="up">
                <span class="eyebrow">Probador</span>
                <h1 class="mt-2">Diseña tu <span class="outline" style="color:var(--rose-300)">próximo look</span></h1>
                <p>Crea una cuenta gratis para guardar prendas, combinarlas en el lienzo y compartir tus outfits con la comunidad.</p>
                <div class="cluster middle">
                    <a href="/register" class="btn">Crear cuenta</a>
                    <a href="/login" class="btn btn-light">Ya tengo cuenta</a>
                </div>
            </div>
        {{/if}}
    </div>
</section>

{{#if user}}
    <script src="/js/outfit-builder.js?v=4"></script>
{{/if}}
