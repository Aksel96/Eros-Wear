{{!-- ============================================================= --}}
{{!-- HERO                                                          --}}
{{!-- ============================================================= --}}
<section class="hero grain">
    <div class="hero-bg-word" aria-hidden="true">EROS</div>
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-6">
                <span class="eyebrow reveal">Colección 2026 · Hecho en México</span>
                <h1 class="hero-title reveal reveal-d1">
                    Viste la
                    <span class="outline">audacia</span>
                    <span class="script">elegancia sin miedo</span>
                </h1>
                <p class="hero-copy reveal reveal-d2">
                    Fusionamos el corte clásico con el pulso del street wear. Explora el catálogo,
                    combina prendas en el probador y comparte tus looks con la comunidad.
                </p>
                <div class="hero-actions reveal reveal-d3">
                    <a href="/shop" class="btn-eros">Explorar catálogo {{{icon 'arrow'}}}</a>
                    <a href="/tester" class="btn-light-ghost">Crear un outfit</a>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="hero-visual">
                    <div class="hero-ring"></div>
                    <svg class="hero-stamp" viewBox="0 0 120 120" aria-hidden="true">
                        <defs><path id="stampCircle" d="M60,60 m-46,0 a46,46 0 1,1 92,0 a46,46 0 1,1 -92,0"/></defs>
                        <text><textPath href="#stampCircle">Eros Wear ✦ Atrevimiento ✦ Elegancia ✦</textPath></text>
                    </svg>
                    <img src="/img/garments/chaqueta-morada.png" alt="Chaqueta Amethyst Rebel de Eros Wear" class="hero-garment">
                    {{#if stats}}
                        <div class="hero-badge b1">
                            <strong>{{stats.garments}}</strong>
                            prendas en catálogo
                        </div>
                        <div class="hero-badge b2">
                            <strong>{{stats.outfits}}</strong>
                            outfits creados
                        </div>
                    {{/if}}
                </div>
            </div>
        </div>
    </div>
    <div class="hero-scroll">Desliza</div>
</section>

{{> marquee tilted=true}}

{{#if dbError}}
    <div class="container mt-5">
        <div class="db-alert">No pudimos conectar con la base de datos. Revisa la configuración y vuelve a intentarlo.</div>
    </div>
{{/if}}

{{!-- ============================================================= --}}
{{!-- TENDENCIA                                                     --}}
{{!-- ============================================================= --}}
<section class="section">
    <div class="container">
        <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-5">
            <div class="reveal">
                <span class="eyebrow">#TrendingTopic</span>
                <h2 class="section-title">En <em>tendencia</em><br>esta semana</h2>
            </div>
            <a href="/shop" class="btn-ghost reveal">Ver todo el catálogo {{{icon 'arrow'}}}</a>
        </div>

        {{#if trending}}
            <div class="rail reveal">
                {{#each trending}}
                    <a href="/shop?category={{category}}" class="trend-card">
                        <div class="trend-word" aria-hidden="true">{{name}} {{name}} {{name}} {{name}}</div>
                        <img src="{{image_url}}" alt="{{name}}" loading="lazy">
                        <div class="trend-info">
                            <div>
                                <small>{{categoryLabel category}}</small>
                                <h4>{{name}}</h4>
                            </div>
                            <span class="trend-arrow">{{{icon 'arrow'}}}</span>
                        </div>
                    </a>
                {{/each}}
            </div>
        {{else}}
            <div class="empty-state">
                <div class="empty-icon">{{{icon 'hanger'}}}</div>
                <h3>El catálogo está vacío</h3>
                <p>Carga las prendas iniciales con <code>npm run db:init</code>.</p>
            </div>
        {{/if}}
    </div>
</section>

{{!-- ============================================================= --}}
{{!-- MANIFIESTO / SOBRE NOSOTROS                                   --}}
{{!-- ============================================================= --}}
<section class="section section-white" id="nosotros">
    <div class="container">
        <div class="row g-5 align-items-center">
            <div class="col-lg-5 reveal">
                <div class="about-visual">
                    <img src="/img/garments/Peach Sunrise.png" alt="Chaqueta Peach Sunrise" loading="lazy">
                    <div class="about-caption">
                        <div>
                            <small>Última colección</small>
                            <strong>Peach Sunrise</strong>
                        </div>
                        <a href="/shop" class="btn-rose btn-sm-eros">Ver</a>
                    </div>
                </div>
            </div>
            <div class="col-lg-7">
                <span class="eyebrow reveal">Sobre nosotros</span>
                <p class="manifesto-quote mt-3 reveal reveal-d1">
                    Inspirados en <span>Eros</span>, símbolo del deseo y la atracción, creamos prendas
                    para quienes no temen <span class="rose">destacar</span>.
                </p>
                <ul class="value-list">
                    <li class="reveal reveal-d1">
                        <span class="num">01</span>
                        <div>
                            <h4>Mitología y street wear</h4>
                            <p>Cortes clásicos con texturas y siluetas contemporáneas. Cada pieza es una declaración.</p>
                        </div>
                    </li>
                    <li class="reveal reveal-d2">
                        <span class="num">02</span>
                        <div>
                            <h4>Orgullosamente mexicana</h4>
                            <p>Conceptualizamos y diseñamos en México, apostando por el talento local y una calidad que trasciende fronteras.</p>
                        </div>
                    </li>
                    <li class="reveal reveal-d3">
                        <span class="num">03</span>
                        <div>
                            <h4>Tu estilo, tu firma</h4>
                            <p>Combina, crea y comparte. La comunidad Eros se construye con cada outfit que diseñas.</p>
                        </div>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</section>

{{!-- ============================================================= --}}
{{!-- OUTFITS POPULARES                                             --}}
{{!-- ============================================================= --}}
<section class="section section-dark grain">
    <div class="container position-relative" style="z-index: 2;">
        <div class="row g-4 align-items-end mb-5">
            <div class="col-lg-7 reveal">
                <span class="eyebrow">Hall of fame</span>
                <h2 class="section-title">Outfits <em>más</em><br>amados</h2>
            </div>
            <div class="col-lg-5 reveal reveal-d1">
                {{#if stats}}
                    <div class="stats-strip">
                        <div><strong>{{stats.garments}}</strong><span>Prendas</span></div>
                        <div><strong>{{stats.outfits}}</strong><span>Outfits</span></div>
                        <div><strong>{{stats.creators}}</strong><span>Creadores</span></div>
                    </div>
                {{/if}}
            </div>
        </div>

        {{#if topOutfits}}
            <div class="row g-4">
                {{#each topOutfits}}
                    <div class="col-sm-6 col-lg-4 reveal">
                        <article class="outfit-card podium-card">
                            <div class="outfit-stage dark">
                                <span class="rank">{{pad (add @index 1)}}</span>
                                <div class="outfit-render" data-outfit-items="{{json items}}">
                                    <div class="outfit-loading">Cargando</div>
                                </div>
                            </div>
                            <div class="outfit-body">
                                <h3>{{name}}</h3>
                                <div class="outfit-footer">
                                    <span class="outfit-creator"><span class="avatar">{{initial creator}}</span>{{creator}}</span>
                                    <span class="like-static">{{{icon 'heart' filled=true}}} {{likesCount}}</span>
                                </div>
                            </div>
                        </article>
                    </div>
                {{/each}}
            </div>
            <div class="text-center mt-5">
                <a href="/gallery?sort_by=likes" class="btn-light-ghost">Ver toda la galería {{{icon 'arrow'}}}</a>
            </div>
        {{else}}
            <div class="empty-state">
                <div class="empty-icon">{{{icon 'sparkle'}}}</div>
                <h3 class="text-white">Aún no hay outfits destacados</h3>
                <p>Sé la primera persona en crear uno y aparecer aquí.</p>
                <a href="/tester" class="btn-eros">Ir al probador</a>
            </div>
        {{/if}}
    </div>
</section>

{{!-- ============================================================= --}}
{{!-- CÓMO FUNCIONA                                                 --}}
{{!-- ============================================================= --}}
<section class="section">
    <div class="container">
        <div class="text-center mb-5 reveal">
            <span class="eyebrow">Cómo funciona</span>
            <h2 class="section-title">Tu estudio de <em>estilo</em></h2>
        </div>
        <div class="row g-4">
            <div class="col-md-4 reveal">
                <div class="step-card">
                    <span class="step-num">01</span>
                    <div class="step-icon">{{{icon 'hanger'}}}</div>
                    <h3>Elige</h3>
                    <p>Recorre el catálogo y agrega a tu probador las prendas que te llamen.</p>
                </div>
            </div>
            <div class="col-md-4 reveal reveal-d1">
                <div class="step-card">
                    <span class="step-num">02</span>
                    <div class="step-icon">{{{icon 'layers'}}}</div>
                    <h3>Combina</h3>
                    <p>Arrastra y acomoda cada pieza en el lienzo hasta encontrar tu look.</p>
                </div>
            </div>
            <div class="col-md-4 reveal reveal-d2">
                <div class="step-card">
                    <span class="step-num">03</span>
                    <div class="step-icon">{{{icon 'share'}}}</div>
                    <h3>Comparte</h3>
                    <p>Guarda tu outfit en la galería y recibe likes de la comunidad.</p>
                </div>
            </div>
        </div>
        <div class="text-center mt-5 reveal">
            <a href="{{#if user}}/tester{{else}}/register{{/if}}" class="btn-eros">
                {{#if user}}Abrir mi probador{{else}}Crear mi cuenta gratis{{/if}} {{{icon 'arrow'}}}
            </a>
        </div>
    </div>
</section>

{{!-- ============================================================= --}}
{{!-- NEWSLETTER                                                    --}}
{{!-- ============================================================= --}}
<section class="section pt-0">
    <div class="container">
        <div class="newsletter reveal">
            <div class="row align-items-center g-4">
                <div class="col-lg-6">
                    <span class="eyebrow" style="color: var(--rose-300);">Newsletter</span>
                    <h2 class="section-title" style="font-size: clamp(2rem, 4vw, 3.2rem);">Sé el primero<br>en saberlo</h2>
                </div>
                <div class="col-lg-6">
                    <p class="text-soft mb-3">Lanzamientos, colaboraciones y drops exclusivos directo a tu bandeja de entrada.</p>
                    <form id="newsletter-form" class="newsletter-form" novalidate>
                        <input type="email" placeholder="tu@correo.com" aria-label="Correo electrónico" required>
                        <button class="btn-rose" type="submit">Suscribirme</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>
