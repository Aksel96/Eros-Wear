{{!-- HERO --}}
<section class="hero grain">
    <div class="hero-bg-word" aria-hidden="true" data-parallax="-0.12">EROS</div>
    <div class="wrap">
        <div>
            <span class="eyebrow" data-hero style="--h:0">Catálogo 2026 · Hecho en México</span>
            <h1 class="hero-title" data-hero style="--h:1">
                Viste la
                <span class="outline">audacia</span>
                <span class="script">elegancia sin miedo</span>
            </h1>
            <p class="hero-copy" data-hero style="--h:2">
                Fusionamos el corte clásico con el pulso del street wear. Explora el catálogo,
                combina prendas en el probador y comparte tus looks con la comunidad.
            </p>
            <div class="hero-actions" data-hero style="--h:3">
                <a href="/shop" class="btn">Explorar catálogo {{{icon 'arrow'}}}</a>
                <a href="/tester" class="btn btn-light">Crear un outfit</a>
            </div>
        </div>

        <div class="hero-visual" data-hero style="--h:2" data-parallax="0.08">
            <div class="hero-ring"></div>
            <svg class="hero-stamp" viewBox="0 0 120 120" aria-hidden="true">
                <defs><path id="stampCircle" d="M60,60 m-46,0 a46,46 0 1,1 92,0 a46,46 0 1,1 -92,0"/></defs>
                <text><textPath href="#stampCircle">Eros Wear ✦ Atrevimiento ✦ Elegancia ✦</textPath></text>
            </svg>
            <img src="/img/garments/chaqueta-morada.png" alt="Chaqueta Amethyst Rebel de Eros Wear" class="hero-garment" fetchpriority="high">
            {{#if stats}}
                <div class="hero-badge b1"><strong>{{stats.garments}}</strong>prendas en catálogo</div>
                <div class="hero-badge b2"><strong>{{stats.outfits}}</strong>outfits creados</div>
            {{/if}}
        </div>
    </div>
    <div class="hero-scroll">Desliza</div>
</section>

{{> marquee}}

{{#if dbError}}
    <div class="wrap section tight-top" style="padding-top:2rem">
        <div class="db-alert">No pudimos conectar con la base de datos. Revisa la configuración y vuelve a intentarlo.</div>
    </div>
{{/if}}

{{!-- TENDENCIA --}}
<section class="section">
    <div class="wrap">
        <div class="section-head">
            <div data-reveal="up">
                <span class="eyebrow">#TrendingTopic</span>
                <h2 class="title">En <em>tendencia</em><br>esta semana</h2>
            </div>
            <a href="/shop" class="btn btn-ghost btn-sm" data-reveal="up">Ver todo el catálogo {{{icon 'arrow'}}}</a>
        </div>

        {{#if trending}}
            <div class="rail" data-stagger>
                {{#each trending}}
                    <a href="/product/{{id}}" class="trend-card" data-reveal="up" style="--i:{{@index}}">
                        <div class="trend-word" aria-hidden="true">{{name}} {{name}} {{name}} {{name}}</div>
                        <img src="{{image_url}}" alt="{{name}}" loading="lazy">
                        <div class="trend-info">
                            <div>
                                <small>{{categoryLabel category}}</small>
                                <h4>{{name}}</h4>
                                <span class="trend-price">{{money price}}</span>
                            </div>
                            <span class="trend-arrow">{{{icon 'arrow'}}}</span>
                        </div>
                    </a>
                {{/each}}
            </div>
        {{else}}
            <div class="empty-state">
                <div class="empty-icon">{{{icon 'hanger'}}}</div>
                <h3>El catálogo está vacío</h3>
                <p>Carga las prendas iniciales con <code>npm run db:init</code>.</p>
            </div>
        {{/if}}
    </div>
</section>

{{!-- MANIFIESTO --}}
<section class="section light" id="nosotros">
    <div class="wrap split">
        <div data-reveal="mask">
            <div class="about-visual">
                <img src="/img/garments/Peach Sunrise.png" alt="Chaqueta Peach Sunrise" loading="lazy" data-parallax="0.06">
                <div class="about-caption">
                    <div>
                        <small>Última colección</small>
                        <strong>Peach Sunrise</strong>
                    </div>
                    <a href="/shop" class="btn btn-rose btn-sm">Ver</a>
                </div>
            </div>
        </div>
        <div>
            <span class="eyebrow" data-reveal="up">Sobre nosotros</span>
            <p class="manifesto" data-split>Inspirados en <span>Eros</span>, símbolo del deseo y la atracción, creamos prendas para quienes no temen <span class="rose">destacar</span>.</p>
            <ul class="value-list" data-stagger>
                <li data-reveal="up" style="--i:0">
                    <span class="num">01</span>
                    <div><h4>Mitología y street wear</h4><p>Cortes clásicos con texturas y siluetas contemporáneas. Cada pieza es una declaración.</p></div>
                </li>
                <li data-reveal="up" style="--i:1">
                    <span class="num">02</span>
                    <div><h4>Orgullosamente mexicana</h4><p>Conceptualizamos y diseñamos en México, apostando por el talento local y una calidad que trasciende fronteras.</p></div>
                </li>
                <li data-reveal="up" style="--i:2">
                    <span class="num">03</span>
                    <div><h4>Tu estilo, tu firma</h4><p>Combina, crea y comparte. La comunidad Eros se construye con cada outfit que diseñas.</p></div>
                </li>
            </ul>
        </div>
    </div>
</section>

{{!-- OUTFITS POPULARES --}}
<section class="section dark grain">
    <div class="wrap" style="position:relative;z-index:2;">
        <div class="section-head">
            <div data-reveal="up">
                <span class="eyebrow">Hall of fame</span>
                <h2 class="title">Outfits <em>más</em><br>amados</h2>
            </div>
            {{#if stats}}
                <div class="stats-strip" data-reveal="up" data-d="150" style="min-width:min(100%,360px)">
                    <div><strong data-count="{{stats.garments}}">{{stats.garments}}</strong><span>Prendas</span></div>
                    <div><strong data-count="{{stats.outfits}}">{{stats.outfits}}</strong><span>Outfits</span></div>
                    <div><strong data-count="{{stats.creators}}">{{stats.creators}}</strong><span>Creadores</span></div>
                </div>
            {{/if}}
        </div>

        {{#if topOutfits}}
            <div class="grid grid-cards" data-stagger>
                {{#each topOutfits}}
                    <article class="outfit-card podium-card" data-reveal="up" style="--i:{{@index}}">
                        <div class="outfit-stage dark">
                            <span class="rank">{{pad (add @index 1)}}</span>
                            <div class="outfit-render" data-outfit-items="{{json items}}">
                                <div class="outfit-loading">Cargando</div>
                            </div>
                        </div>
                        <div class="outfit-body">
                            <h3>{{name}}</h3>
                            <div class="outfit-footer">
                                <span class="outfit-creator"><span class="avatar">{{initial creator}}</span>{{creator}}</span>
                                <span class="like-static">{{{icon 'heart' filled=true}}} {{likesCount}}</span>
                            </div>
                            <button type="button" class="btn btn-rose btn-sm btn-block" data-add-look="{{json (lookIds items)}}">{{{icon 'bag'}}} Comprar este look</button>
                        </div>
                    </article>
                {{/each}}
            </div>
            <div class="center mt-4" data-reveal="up">
                <a href="/gallery?sort_by=likes" class="btn btn-light">Ver toda la galería {{{icon 'arrow'}}}</a>
            </div>
        {{else}}
            <div class="empty-state">
                <div class="empty-icon">{{{icon 'sparkle'}}}</div>
                <h3>Aún no hay outfits destacados</h3>
                <p>Sé la primera persona en crear uno y aparecer aquí.</p>
                <a href="/tester" class="btn">Ir al probador</a>
            </div>
        {{/if}}
    </div>
</section>

{{!-- EL PROBADOR --}}
<section class="section">
    <div class="wrap">
        <div class="center mb-4" data-reveal="up">
            <span class="eyebrow">El probador</span>
            <h2 class="title">Tu estudio de <em>estilo</em></h2>
        </div>
        <div class="grid grid-steps" data-stagger>
            <div class="step-card" data-reveal="up" style="--i:0">
                <span class="step-num">01</span>
                <div class="step-icon">{{{icon 'hanger'}}}</div>
                <h3>Elige</h3>
                <p>Recorre el catálogo y agrega a tu probador las prendas que te llamen.</p>
            </div>
            <div class="step-card" data-reveal="up" style="--i:1">
                <span class="step-num">02</span>
                <div class="step-icon">{{{icon 'layers'}}}</div>
                <h3>Combina</h3>
                <p>Arrastra y acomoda cada pieza en el lienzo hasta encontrar tu look.</p>
            </div>
            <div class="step-card" data-reveal="up" style="--i:2">
                <span class="step-num">03</span>
                <div class="step-icon">{{{icon 'share'}}}</div>
                <h3>Comparte</h3>
                <p>Guarda tu outfit en la galería y recibe likes de la comunidad.</p>
            </div>
        </div>
        <div class="center mt-4" data-reveal="up">
            <a href="{{#if user}}/tester{{else}}/register{{/if}}" class="btn">
                {{#if user}}Abrir mi probador{{else}}Crear mi cuenta gratis{{/if}} {{{icon 'arrow'}}}
            </a>
        </div>
    </div>
</section>

{{!-- CÓMO PEDIR --}}
<section class="section dark grain" id="como-pedir">
    <div class="wrap" style="position:relative;z-index:2;">
        <div class="mb-4" data-reveal="up">
            <span class="eyebrow">Cómo pedir</span>
            <h2 class="title">Pide en <em>cuatro</em> pasos</h2>
            <p class="lead text-soft mt-2">Sin pago en línea: atención personal por WhatsApp.</p>
        </div>
        <div class="grid grid-how" data-stagger>
            <div class="how-card" data-reveal="up" style="--i:0"><h3>Elige</h3><p>Explora el catálogo y revisa tallas y disponibilidad de cada prenda.</p></div>
            <div class="how-card" data-reveal="up" style="--i:1"><h3>Arma tu carrito</h3><p>Agrega varias prendas, ajusta cantidades y mira tu total al instante.</p></div>
            <div class="how-card" data-reveal="up" style="--i:2"><h3>Envía por WhatsApp</h3><p>Con un clic mandamos tu pedido ya armado, con tu referencia.</p></div>
            <div class="how-card" data-reveal="up" style="--i:3"><h3>Coordinamos</h3><p>Confirmamos disponibilidad, forma de pago y entrega contigo.</p></div>
        </div>
    </div>
</section>

{{!-- NEWSLETTER --}}
<section class="section">
    <div class="wrap">
        <div class="newsletter" data-reveal="zoom">
            <div>
                <span class="eyebrow" style="color: var(--rose-300);">Newsletter</span>
                <h2 class="title" style="color:#fff;font-size:clamp(2rem,6vw,3.2rem)">Sé el primero<br>en saberlo</h2>
            </div>
            <div>
                <p class="text-soft mb-2" style="color:rgba(255,255,255,.75)">Lanzamientos, colaboraciones y drops exclusivos directo a tu bandeja de entrada.</p>
                <form id="newsletter-form" class="newsletter-form" novalidate>
                    <input type="email" placeholder="tu@correo.com" aria-label="Correo electrónico" required>
                    <button class="btn btn-rose" type="submit">Suscribirme</button>
                </form>
            </div>
        </div>
    </div>
</section>
