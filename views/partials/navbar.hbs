<header class="navbar-eros" id="siteNav">
    <div class="container d-flex align-items-center">
        <a class="brand" href="/" aria-label="Eros Wear, inicio">
            <span class="brand-mark">E</span>
            Eros<small>Wear</small>
        </a>

        <button class="nav-toggle" type="button" id="navToggle" aria-label="Abrir menú" aria-expanded="false" aria-controls="navPanel">
            <span></span><span></span><span></span>
        </button>

        <nav class="nav-panel" id="navPanel">
            <ul class="nav-links">
                <li><a href="/" class="{{#if (eq currentPath '/')}}active{{/if}}">Inicio</a></li>
                <li><a href="/shop" class="{{#if (startsWith currentPath '/shop')}}active{{/if}}">Catálogo</a></li>
                <li><a href="/tester" class="{{#if (startsWith currentPath '/tester')}}active{{/if}}">Probador</a></li>
                <li><a href="/gallery" class="{{#if (startsWith currentPath '/gallery')}}active{{/if}}">Galería</a></li>
                <li><a href="/visitors" class="{{#if (startsWith currentPath '/visitors')}}active{{/if}}">Comunidad</a></li>
            </ul>

            <div class="nav-auth">
                {{#if user}}
                    <div class="dropdown">
                        <button class="user-chip dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <span class="avatar">{{initial user.nickname}}</span>
                            <span>{{user.nickname}}</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end dropdown-menu-eros">
                            <li><a class="dropdown-item" href="/tester">Mi probador</a></li>
                            <li><a class="dropdown-item" href="/gallery?mine=1">Mis outfits</a></li>
                            <li><a class="dropdown-item" href="/shop">Agregar prendas</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item" href="/logout">Cerrar sesión</a></li>
                        </ul>
                    </div>
                {{else}}
                    <a class="btn-light-ghost" href="/login">Entrar</a>
                    <a class="btn-eros" href="/register">Crear cuenta</a>
                {{/if}}
            </div>
        </nav>

        <button type="button" class="cart-toggle" data-open-cart aria-label="Abrir carrito">
            {{{icon 'bag'}}}<span class="cart-count d-none">0</span>
        </button>
    </div>
</header>
