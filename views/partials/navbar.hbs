<header class="site-header" id="siteNav">
    <div class="wrap">
        <a class="brand" href="/" aria-label="Eros Wear, inicio">
            <span class="brand-mark">E</span>
            Eros<small>Wear</small>
        </a>

        <nav class="nav-links" aria-label="Principal">
            <a href="/" class="{{#if (eq currentPath '/')}}active{{/if}}">Inicio</a>
            <a href="/shop" class="{{#if (startsWith currentPath '/shop')}}active{{/if}}">Catálogo</a>
            <a href="/tester" class="{{#if (startsWith currentPath '/tester')}}active{{/if}}">Probador</a>
            <a href="/gallery" class="{{#if (startsWith currentPath '/gallery')}}active{{/if}}">Galería</a>
            <a href="/visitors" class="{{#if (startsWith currentPath '/visitors')}}active{{/if}}">Comunidad</a>
        </nav>

        <div class="header-actions">
            {{#if user}}
                <button type="button" class="btn btn-light btn-sm desktop-only" data-toggle-account aria-haspopup="true" aria-controls="accountMenu">
                    <span class="avatar" style="width:26px;height:26px;font-size:.65rem;">{{initial user.nickname}}</span> {{user.nickname}}
                </button>
            {{else}}
                <a class="btn btn-light btn-sm desktop-only" href="/login">Entrar</a>
                <a class="btn btn-sm desktop-only" href="/register">Crear cuenta</a>
            {{/if}}
            <button type="button" class="icon-btn" data-open-cart aria-label="Abrir carrito">
                {{{icon 'bag'}}}<span class="cart-count is-hidden">0</span>
            </button>
        </div>
    </div>
    <span class="scroll-progress" id="scrollProgress"></span>
</header>

<div class="account-menu" id="accountMenu" role="dialog" aria-label="Cuenta">
    {{#if user}}
        <div class="who"><span class="avatar">{{initial user.nickname}}</span> {{user.nickname}}</div>
        <a href="/tester">{{{icon 'layers'}}} Mi probador</a>
        <a href="/gallery?mine=1">{{{icon 'sparkle'}}} Mis outfits</a>
        <a href="/shop">{{{icon 'plus'}}} Agregar prendas</a>
        <a href="/visitors">{{{icon 'user'}}} Comunidad</a>
        <a href="/logout">{{{icon 'logout'}}} Cerrar sesión</a>
    {{else}}
        <div class="who">Únete a Eros Wear</div>
        <a href="/visitors">{{{icon 'user'}}} Comunidad</a>
        <a class="btn btn-block" href="/register" style="color:#fff;border-bottom:0;">Crear cuenta</a>
        <a class="btn btn-light btn-block" href="/login" style="border-bottom:0;">Entrar</a>
    {{/if}}
</div>
