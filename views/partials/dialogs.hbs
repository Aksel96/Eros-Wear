{{!-- Diálogo reutilizable de confirmación / captura de texto (ver ErosUI en main.js) --}}
<dialog class="eros-dialog" id="erosDialog" aria-labelledby="erosDialogTitle">
    <form class="dialog-inner" id="erosDialogForm" method="dialog" novalidate>
        <h2 id="erosDialogTitle">Confirmar</h2>
        <p id="erosDialogMessage" class="text-soft"></p>
        <div class="field is-hidden mt-2" id="erosDialogField">
            <label for="erosDialogInput" id="erosDialogLabel">Nombre</label>
            <input type="text" class="input" id="erosDialogInput" maxlength="100" autocomplete="off">
        </div>
        <div class="dialog-actions">
            <button type="button" class="btn btn-ghost btn-sm" id="erosDialogCancel">Cancelar</button>
            <button type="submit" class="btn btn-sm" id="erosDialogOk">Aceptar</button>
        </div>
    </form>
</dialog>
