<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <title>{{#if title}}{{title}} · {{/if}}Eros Wear</title>
    <meta name="description" content="Eros Wear: elegancia audaz con corazón mexicano. Explora el catálogo, crea outfits en el probador y compártelos con la comunidad.">
    <meta name="theme-color" content="#0a0810">
    <meta property="og:title" content="Eros Wear · Viste la audacia">
    <meta property="og:description" content="Elegancia atemporal y street wear con corazón mexicano.">
    <meta property="og:image" content="/img/garments/chaqueta-morada.png">
    <link rel="icon" href="/img/favicon.svg" type="image/svg+xml">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;700&family=Lato:wght@400;700&family=Montserrat:wght@600;700;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/app.css?v=4">
    <script>document.documentElement.classList.add('js');</script>
</head>
<body>
<a class="sr-only" href="#contenido">Saltar al contenido</a>

{{> navbar}}

<main id="contenido">
    {{{body}}}
</main>

{{#unless isStudio}}
    {{> footer}}
{{/unless}}

{{> tabbar}}

{{!-- Mensajes del servidor (flash) que main.js convierte en toasts --}}
<div class="toast-stack" id="toastStack" aria-live="polite">
    {{#each success_msg}}<div class="is-hidden" data-flash="success">{{this}}</div>{{/each}}
    {{#each error_msg}}<div class="is-hidden" data-flash="error">{{this}}</div>{{/each}}
</div>

{{#if whatsappUrl}}<a class="wa-float" href="{{whatsappUrl}}" target="_blank" rel="noopener" aria-label="Escríbenos por WhatsApp">{{{icon 'whatsapp'}}}</a>{{/if}}

<div class="backdrop" id="backdrop" data-close-layers></div>
{{> dialogs}}
{{> cart}}

<script src="/js/main.js?v=4"></script>
<script src="/js/cart.js?v=4"></script>
</body>
</html>
