{{! views/gallery.hbs }}

<style>
    /* ----------------------------------- */
    /* Estilos de la marca Eros Wear */
    /* ----------------------------------- */
    .brand-title {
        font-family: 'Cinzel', serif;
        color: #5E35B1; /* Deep Amethyst */
        font-weight: 700;
    }
    .brand-subtitle {
        color: #B7926F; /* Rose Gold Muted */
        font-family: 'Lato', sans-serif;
    }
    .card-header-brand {
        background-color: #B7926F !important; /* Deep Amethyst */
        color: white;
        font-family: 'Lato', sans-serif;
    }
    .edit-btn {
        background-color: #B7926F; /* Rose Gold Muted */
        border-color: #B7926F;
        color: #263238; /* Charcoal Dusk */
        transition: background-color 0.2s;
    }
    .edit-btn:hover {
        background-color: #c9a385;
        border-color: #c9a385;
    }
</style>

<h1 class="text-center my-4 brand-title pt-3">Galería de Outfits en Eros Wear</h1>
<p class="lead text-center brand-subtitle">Explora la creatividad de la comunidad</p>

{{!-- CONTROLES DE ORDENAMIENTO --}}
<div class="row justify-content-end mb-4">
    <div class="col-md-4 col-lg-3">
        <form method="GET" action="/gallery" class="d-flex align-items-center">
            <label for="sort-select" class="form-label small mb-0 me-2 text-muted">Ordenar por:</label>
            <select name="sort_by" id="sort-select" class="form-select form-select-sm" onchange="this.form.submit()">
                <option value="newest" {{#if (eq currentSort 'newest')}}selected{{/if}}>Más Recientes</option>
                <option value="likes" {{#if (eq currentSort 'likes')}}selected{{/if}}>Popularidad (Más Likes)</option>
            </select>
            {{!-- No necesitamos un botón de submit, el onchange lo hace --}}
        </form>
    </div>
</div>

<hr>

<div class="row">
    {{#if outfits}}
        {{#each outfits}}
            <div class="col-lg-4 col-md-6 mb-4">
                <div class="card shadow-sm h-100">

                    {{!-- Cabecera de la tarjeta con estilo de marca --}}
                    <div class="card-header card-header-brand">
                        <h5 class="mb-0" style="font-weight: bold;">{{name}}</h5>
                        <small>Creado por: <strong>{{creator}}</strong></small>
                    </div>

                    {{!-- Contenedor para el Canvas Renderizado --}}
                    <div class="card-body">
                        <div class="outfit-preview border border-secondary bg-light position-relative mx-auto"
                             style="width: 100%; height: 300px; overflow: hidden;"
                             data-outfit-items="{{json items}}">
                            <p class="text-center text-muted m-0 p-3">Cargando</p>
                        </div>
                    </div>

                    <div class="card-footer d-flex justify-content-between align-items-center">
                        <small class="text-muted">Guardado: {{dateFormat createdAt}}</small>

                        <div class="d-flex align-items-center">

                            {{!-- Botón de Like (Siempre habilitado) --}}
                            <button
                                    class="btn btn-sm like-btn me-2 btn-outline-danger"
                                    data-outfit-id="{{id}}">
                                🤍 Like
                            </button>

                            {{!-- Botón de Eliminación/Edición (Solo dueño) --}}
                            {{#if ../user}}
                            {{!-- Botón de Eliminación/Edición (Solo dueño) --}}
                                {{#if (isOwner ../user.id creatorId)}}
                                    <button
                                            class="btn btn-sm edit-outfit-btn me-1"
                                            data-outfit-id="{{id}}"
                                            title="Editar outfit">
                                        ✏️
                                    </button>
                                    <form action="/outfits/delete/{{id}}" method="POST" onsubmit="return confirm('¿Estás seguro de eliminar el outfit: {{name}}?');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Eliminar Outfit">🗑️</button>
                                    </form>
                                {{/if}}
                            {{/if}}

                        </div>
                    </div>
                </div>
            </div>
        {{/each}}
    {{else}}
        <div class="col-12">
            <div class="alert alert-warning text-center">
                Aún no hay outfits guardados en la galería
            </div>
        </div>
    {{/if}}
</div>

{{!-- Script para renderizar los outfits y la lógica de likes --}}
<script src="/js/gallery-renderer.js"></script>