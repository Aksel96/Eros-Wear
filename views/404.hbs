<section class="error-page grain">
    <div>
        <div class="code">{{#if code}}{{code}}{{else}}404{{/if}}</div>
        <h1>{{#if message}}Algo salió mal{{else}}Esta página se fue de fiesta{{/if}}</h1>
        <p>{{#if message}}{{message}}{{else}}No encontramos lo que buscas. Quizá cambió de lugar o nunca existió.{{/if}}</p>
        <div class="cluster">
            <a href="/" class="btn">Volver al inicio</a>
            <a href="/shop" class="btn btn-light">Ver catálogo</a>
        </div>
    </div>
</section>
