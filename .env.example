# Copia este archivo como .env y completa los valores.

# --- Base de datos (MySQL 8 / TiDB Cloud) ---
# Opción A: una sola URL (la que te da el proveedor)
# DATABASE_URL=mysql://usuario:contraseña@host:4000/eros_wear

# Opción B: variables por separado
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=eros_wear

# TLS: obligatorio en TiDB Cloud y en la mayoría de proveedores en la nube
DB_SSL=false
# Solo si tu proveedor entrega un certificado de CA propio (pega el PEM con \n)
# DB_SSL_CA=

# --- Aplicación ---
SESSION_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria
NODE_ENV=development
PORT=3000
